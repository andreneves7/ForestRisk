# ─── Copia para .env e preenche com os teus valores reais ────────────────────
# cp .env.example .env

# NASA FIRMS API key
# Obtém em: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_KEY=a_tua_key_aqui

# InfluxDB
INFLUXDB_PASSWORD=escolhe_uma_password
INFLUXDB_TOKEN=escolhe_um_token

# Grafana
GRAFANA_PASSWORD=escolhe_uma_password
